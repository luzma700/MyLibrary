<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título Principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Mi Biblioteca"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp" />

        <!-- Sección de Búsqueda en API -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Buscar Libros en Open Library"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etBuscarLibro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresa título del libro..."
            android:maxLines="1"
            android:padding="16dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Buscar"
            android:textSize="16sp"
            android:padding="12dp"
            android:backgroundTint="@color/blue"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp" />

        <!-- Resultados de Búsqueda -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Libros encontrados:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerLibros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/edittext_background"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnGuardarLibro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Guardar en Mi Biblioteca"
            android:textSize="16sp"
            android:padding="12dp"
            android:backgroundTint="@color/gray"
            android:textColor="@color/white"
            android:layout_marginBottom="32dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/gray"
            android:layout_marginBottom="24dp" />

        <!-- Sección de Libros Guardados -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 Mis Libros Guardados"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca 🗑️ para eliminar un libro"
            android:textSize="14sp"
            android:textColor="@color/gray"
            android:layout_marginBottom="16dp" />

        <ListView
            android:id="@+id/listViewLibrosGuardados"
            android:layout_width="match_parent"
            android:layout_height="581dp"
            android:layout_marginBottom="24dp" />

        <!-- Botón Volver -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Volver al Home"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="@android:color/transparent"
            android:textColor="@color/blue" />

    </LinearLayout>
</ScrollView>